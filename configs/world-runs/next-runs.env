# Shared WSL configuration for scripts/world_runs/*.sh.
# Override any value in the shell before launching a script.

WORLD_VENV="${WORLD_VENV:-$HOME/gtr_venv}"
WORLD_DEVICE="${WORLD_DEVICE:-cuda}"
WORLD_GPU_DEVICES="${WORLD_GPU_DEVICES:-1}"

YOLOX_SOURCE="${YOLOX_SOURCE:-artifacts/YOLOX}"
YOLOX_EXP="${YOLOX_EXP:-src/manifoldflow/experiments/world_yolox_nano.py}"
YOLOX_INIT_CKPT="${YOLOX_INIT_CKPT:-checkpoints/world/yolox-runs/world_yolox_real_dense/best_ckpt.pth}"
YOLOX_OUTPUT_DIR="${YOLOX_OUTPUT_DIR:-checkpoints/world/yolox-runs}"
YOLOX_BATCH_SIZE="${YOLOX_BATCH_SIZE:-32}"
YOLOX_WORKERS="${YOLOX_WORKERS:-8}"

WORLD_PERCEPTION_DATASET="${WORLD_PERCEPTION_DATASET:-artifacts/world-corpora/perception-test-train-cups}"
WORLD_SYNTHETIC_DATASET="${WORLD_SYNTHETIC_DATASET:-artifacts/world-sim}"
WORLD_VIDEO_DIR="${WORLD_VIDEO_DIR:-artifacts/world-video-footage}"
WORLD_VIDEO_ANNOTATIONS="${WORLD_VIDEO_ANNOTATIONS:-configs/world-video-annotations}"
WORLD_VIDEO_OUTPUT="${WORLD_VIDEO_OUTPUT:-artifacts/world-video-runs/perception-v1}"

WORLD_PROJECTOR_CKPT="${WORLD_PROJECTOR_CKPT:-checkpoints/world/siglip-key-projector.pt}"
WORLD_GEMMA_CKPT="${WORLD_GEMMA_CKPT:-checkpoints/world/oracle-schema-final.pt}"
WORLD_GEMMA_MODEL="${WORLD_GEMMA_MODEL:-google/gemma-3-270m-it}"
WORLD_DETECTOR_CONFIDENCE="${WORLD_DETECTOR_CONFIDENCE:-0.30}"
WORLD_TRACK_CONFIDENCE="${WORLD_TRACK_CONFIDENCE:-0.35}"

WORLD_RESULTS_DIR="${WORLD_RESULTS_DIR:-artifacts/world-run-results}"
SCALE_RESULTS_DIR="${SCALE_RESULTS_DIR:-artifacts/manifoldflow-scale/repeat}"

# Promotion gates. These are mirrored in gates.json for machine-readable review.
GATE_REAL_MAP5095="${GATE_REAL_MAP5095:-0.45}"
GATE_REAL_CUP_AP5095="${GATE_REAL_CUP_AP5095:-0.55}"
GATE_REAL_BALL_AP5095="${GATE_REAL_BALL_AP5095:-0.30}"
GATE_MAX_SYNTHETIC_CLASS_REGRESSION="${GATE_MAX_SYNTHETIC_CLASS_REGRESSION:-0.05}"
GATE_OBSERVATION_PRECISION="${GATE_OBSERVATION_PRECISION:-0.70}"
GATE_OBSERVATION_RECALL="${GATE_OBSERVATION_RECALL:-0.75}"
GATE_IDENTITY_CONSISTENCY="${GATE_IDENTITY_CONSISTENCY:-0.90}"
GATE_MAX_LABEL_SWITCH_RATE="${GATE_MAX_LABEL_SWITCH_RATE:-0.05}"
GATE_RELATION_PRECISION="${GATE_RELATION_PRECISION:-0.75}"
GATE_RELATION_RECALL="${GATE_RELATION_RECALL:-0.65}"
GATE_RANKED_ANSWER_ACCURACY="${GATE_RANKED_ANSWER_ACCURACY:-0.75}"
GATE_RETRIEVAL_TOP1="${GATE_RETRIEVAL_TOP1:-0.95}"
GATE_CPU_1M_P95_MS="${GATE_CPU_1M_P95_MS:-1.0}"
GATE_RESIDENT_1M_SPEEDUP="${GATE_RESIDENT_1M_SPEEDUP:-2.0}"
